QToolBar,
QWidget#resultToolBar {
  background: #f6f7f9;
  border: none;
  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
}

QWidget#resultToolBar QToolButton:checked {
  background: transparent;
  border: none;
  color: #111111;
}

/* Continue-context toggle: the generic ":checked" rule above is deliberately flat,
   so this one needs its own rule to make the on/off state visible. */
QWidget#resultToolBar QToolButton#contextToggleBtn {
  border: 1px solid transparent;
  border-radius: 4px;
}

QWidget#resultToolBar QToolButton#contextToggleBtn:checked {
  background: rgba(37, 99, 235, 0.16);
  border: 1px solid rgba(37, 99, 235, 0.55);
  color: #1d4ed8;
}

/* Lock button: same treatment as the context toggle so "locked" is unmistakable. */
QWidget#resultToolBar QToolButton#lockToggleBtn {
  border: 1px solid transparent;
  border-radius: 4px;
}

QWidget#resultToolBar QToolButton#lockToggleBtn:checked {
  background: rgba(37, 99, 235, 0.16);
  border: 1px solid rgba(37, 99, 235, 0.55);
  color: #1d4ed8;
}

/* Shared-ish MODE indicator look for native Qt labels */
QLabel#statusIndicator {
  color: #111111;
  background: rgba(0, 0, 0, 0.04);
  border: 1px solid rgba(0, 0, 0, 0.10);
  border-radius: 4px;
  padding: 2px 6px;
  margin: 0px 6px;
  font-size: 12px;
}
